# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://lzndljhymdikayoqckhp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com → API Keys (used for query understanding / result synthesis)
ANTHROPIC_API_KEY=

# Voyage AI — dash.voyageai.com → API Keys (used for embedding listings + search queries)
VOYAGE_API_KEY=

# Resend — resend.com → API Keys (used to send the contact-form thank-you email)
# Optional: without it, contact submissions still save to the DB, just no email is sent.
RESEND_API_KEY=
# Until you verify a sending domain in Resend, leave this unset (defaults to
# onboarding@resend.dev, which can only deliver to your own Resend account
# email). Once you verify a domain, set this to an address on it, e.g.:
# CONTACT_FROM_EMAIL=DelhiDwarka <hello@delhidwarka.in>
CONTACT_FROM_EMAIL=
